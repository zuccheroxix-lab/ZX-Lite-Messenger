# Server configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zxlite_db

# Security & Tokens (Use strong generated secrets in production)
JWT_SECRET=zx_lite_super_secure_jwt_secret_change_in_production_32bytes
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_DAYS=30
BCRYPT_ROUNDS=10

# Rate limits
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
